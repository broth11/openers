      {
       "tex": "B\\hat{C}S &= N\\hat{B}C = 20^{\\circ}"
      },
      {
       "tex": "B\\hat{C}D &= 180^{\\circ} - 85^{\\circ} - 20^{\\circ} = \\textcolor{#B189C6}{75^{\\circ}}"
      }
     ]
    }
