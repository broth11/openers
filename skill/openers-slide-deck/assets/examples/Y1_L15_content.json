   "n": 3,
   "tag": "NC",
   "title": "Perpendicular line through a point",
   "stem": "Find the equation of the line through $B(4,-3)$ perpendicular to $2x - 5y + 1 = 0$. Give your answer in the form $ax + by + d = 0$, where $a, b, d \\in \\mathbb{Z}$.",
   "blocks": [
    {
     "steps": [
      {
       "tex": "-bx + ay &= -b\\,x_B + a\\,y_B"
      },
      {
       "tex": "5x + 2y &= 5(4) + 2(-3)"
      },
      {
       "tex": "5x + 2y &= 14"
      },
      {
       "tex": "\\bl{\\therefore\\quad 5x + 2y - 14} &= \\bl{0}"
      }
     ]
    }
   ],
