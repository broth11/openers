  {
   "type": "example",
   "n": 2,
   "tag": "NC",
   "title": "Reading a line given in general form",
   "stem": "Find the gradient and the $y$-intercept of the line $4x + 6y - 9 = 0$.",
   "blocks": [
    {
     "steps": [
      {
       "tex": "6y &= -4x + 9"
      },
      {
       "tex": "\\therefore\\quad y &= -\\frac{2}{3}x + \\frac{3}{2}"
      }
     ]
    },
    {
     "text": "The gradient is <span class=\"ans\">$-\\tfrac{2}{3}$</span> and the $y$-intercept is <span class=\"ans\">$\\tfrac{3}{2}$</span>."
    }
