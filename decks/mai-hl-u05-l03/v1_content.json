   "title": "Fit the model (1 of 2)",
   "stem": "Fit $S=a+b\\ln h$ through $(1,\\,20)$ and $(10,\\,43.03)$.",
   "blocks": [
    {
     "walk": {
      "cap": "Substitute $(1,\\,20)$",
      "tex": [
       "20&=a+b\\ln 1",
       "20&=a"
      ],
      "note": "$\\ln 1=0$, so $a$ is the speed at $h=1$."
     }
    },
    {
     "walk": {
      "cap": "Substitute $(10,\\,43.03)$",
      "tex": [
       "43.03&=20+b\\ln 10",
       "23.03&=b\\ln 10"
      ]
     }
    }
