  {
   "type": "example",
   "eyebrow": "Cooling coffee · Question 3",
   "title": "When can it be drunk? (2 of 2)",
   "stem": "It can be drunk at $50\\,{}^{\\circ}\\mathrm{C}$ or below. After how many whole minutes is that first true?",
   "blocks": [
    {
     "walk": {
      "cap": "Take logs of both sides",
      "tex": [
       "t\\ln 0.9&=\\ln 0.4",
       "t&=\\frac{\\ln 0.4}{\\ln 0.9}=8.70"
      ]
     }
    },
    {
     "walk": {
      "cap": "Round up to whole minutes",
      "tex": [
       "t&=9"
      ],
      "note": "After $8$ minutes it is still $52.1\\,{}^{\\circ}\\mathrm{C}$. After $9$ it is $49.1\\,{}^{\\circ}\\mathrm{C}$. Round up, not to the nearest whole number.",
      "ans": true
     }
    }
